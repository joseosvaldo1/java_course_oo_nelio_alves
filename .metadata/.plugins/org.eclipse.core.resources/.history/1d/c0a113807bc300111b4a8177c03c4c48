package application;

import java.util.Arrays;
import java.util.List;
import java.util.stream.Stream;

public class Program {
	public static void main(String[] args) {
		List<Integer> list = Arrays.asList(3, 4, 5, 10, 7);
		
		Stream<Integer> st1 = list.stream().map(x -> 10 * x);
		System.out.println(Arrays.toString(st1.toArray()));	  			// => [30, 40, 50, 100, 70]
		
		int sum = list.stream().reduce(0,(x, y) -> x + y ); 			
		System.out.println("Sum = " + sum);								// => Sum = 29
		
		int prod= list.stream().reduce(1,(x, y) -> x * y ); 			
		System.out.println("Product = " + prod);						// => Product = 4200
		
		List<Integer> newList = list.stream()
									.filter(x -> x % 2)
									.map(x -> x * 10);
		
 	}
}
