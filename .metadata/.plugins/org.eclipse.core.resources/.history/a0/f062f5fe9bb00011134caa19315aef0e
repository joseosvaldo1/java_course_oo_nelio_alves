package application;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class Program {
	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		Map<String, Integer> boxResult = new HashMap<>();
		
		System.out.print("Enter file full path: ");
		// path: //home//jose//eclipse-workspace//course_poo_VIII_generics_exercise_III//in.txt
		String path = sc.nextLine();
		
		try (BufferedReader br = new BufferedReader(new FileReader(path))){
			String line = br.readLine();
			
	        
			while(line != null) {
				 
				String[] fields = line.split(",");
				String name = fields[0];
		        Integer votesOfLine = Integer.parseInt(fields[1]);
				
				if(!boxResult.containsKey(name)) {
					boxResult.put(name, votesOfLine);
				} else {
					Integer actualVotes = boxResult.get(name);
					boxResult.put(name, votesOfLine + actualVotes);
				}
				
		        
				// boxResult.put(name, boxResult.getOrDefault(name, 0) + votesOfLine);
				
				
				line = br.readLine();
			}
			
			
		} catch (IOException e) {
			System.out.println("Error: " + e.getMessage());
		}
		
		for(String key : boxResult.keySet()) {
			System.out.println(key + ": " + boxResult.get(key));
		}
		
		
		
		sc.close();
	
	}
}
